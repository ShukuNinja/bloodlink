generator client {
  provider               = "prisma-client"
  output                 = "../apps/api/src/database/generated/prisma"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  INDIVIDUAL
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum OrganizationType {
  HOSPITAL
  BLOOD_CENTRE
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum OrganizationMembershipRole {
  HOSPITAL_ADMIN
  HOSPITAL_STAFF
  BLOOD_CENTRE_ADMIN
  BLOOD_CENTRE_STAFF
}

enum OrganizationMembershipStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum PatientNeedBloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

enum PatientNeedComponent {
  WHOLE_BLOOD
  RED_BLOOD_CELLS
  PLATELETS
  PLASMA
}

enum PatientNeedUrgency {
  ROUTINE
  URGENT
  CRITICAL
}

enum PatientNeedStatus {
  PENDING_HOSPITAL_REVIEW
  VERIFIED
  REJECTED
  CANCELLED
}

model User {
  id            String                   @id @default(uuid()) @db.Uuid
  email         String                   @unique @db.VarChar(320)
  passwordHash  String                   @db.VarChar(255)
  role          UserRole                 @default(INDIVIDUAL)
  status        UserStatus               @default(ACTIVE)
  createdAt     DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime                 @updatedAt @db.Timestamptz(6)
  memberships   OrganizationMembership[]
  refreshTokens RefreshToken[]
  patientNeeds  PatientNeed[]
}

model Organization {
  id           String                   @id @default(uuid()) @db.Uuid
  name         String                   @db.VarChar(255)
  type         OrganizationType
  status       OrganizationStatus       @default(ACTIVE)
  createdAt    DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime                 @updatedAt @db.Timestamptz(6)
  memberships  OrganizationMembership[]
  patientNeeds PatientNeed[]
  latitude     Decimal?                 @db.Decimal(9, 6)
  longitude    Decimal?                 @db.Decimal(9, 6)
}

model OrganizationMembership {
  id             String                       @id @default(uuid()) @db.Uuid
  userId         String                       @db.Uuid
  organizationId String                       @db.Uuid
  role           OrganizationMembershipRole
  status         OrganizationMembershipStatus @default(ACTIVE)
  createdAt      DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime                     @updatedAt @db.Timestamptz(6)
  user           User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, role])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime  @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

model PatientNeed {
  id                String                @id @default(uuid()) @db.Uuid
  submittedByUserId String                @db.Uuid
  hospitalId        String                @db.Uuid
  bloodGroup        PatientNeedBloodGroup
  component         PatientNeedComponent
  units             Int
  urgency           PatientNeedUrgency
  requiredBy        DateTime              @db.Timestamptz(6)
  additionalNotes   String                @db.Text
  status            PatientNeedStatus     @default(PENDING_HOSPITAL_REVIEW)
  createdAt         DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime              @updatedAt @db.Timestamptz(6)
  submittedBy       User                  @relation(fields: [submittedByUserId], references: [id], onDelete: Restrict)
  hospital          Organization          @relation(fields: [hospitalId], references: [id], onDelete: Restrict)

  @@index([submittedByUserId, createdAt])
  @@index([hospitalId, status])
}
