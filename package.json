{
  "name": "bloodlink",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "dev": "pnpm --parallel --filter @bloodlink/api --filter @bloodlink/web --filter @bloodlink/mobile dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write \"apps/**/*.{ts,tsx,json}\" \"packages/**/*.{ts,tsx,json}\" package.json pnpm-workspace.yaml \"*.mjs\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,json}\" \"packages/**/*.{ts,tsx,json}\" package.json pnpm-workspace.yaml \"*.mjs\"",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.46.2"
  }
}
