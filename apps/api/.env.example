NODE_ENV=development
PORT=3001
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bloodlink?schema=public"
JWT_ACCESS_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_random_secret_of_at_least_32_characters
JWT_REFRESH_EXPIRES_IN=7d
